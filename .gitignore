# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/

# Database files
data/*.db
data/*.db-wal
data/*.db-shm

# Logs
logs/*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# User storage (don't commit personal files)
storage/cloud/*
storage/notes/*
storage/downloads/*
storage/bookmarks/*
storage/print-queue/*

# Keep empty directories
!storage/cloud/.gitkeep
!storage/notes/.gitkeep
!storage/downloads/.gitkeep
!storage/bookmarks/.gitkeep
!storage/print-queue/.gitkeep
